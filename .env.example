# Copy to .env and adjust. Every setting is optional.

# 127.0.0.1 = only this computer. 0.0.0.0 = devices on your home network (e.g. a Smart TV) can connect.
NEXONIC_HOST=127.0.0.1
NEXONIC_PORT=8000

# Where the database, playlists, EPG cache and logs are stored.
# NEXONIC_DATA_DIR=./local-data

# Smart TV (Xtream Codes) login. If the password is empty, a random one is generated on first run.
NEXONIC_XTREAM_USER=nexonic
NEXONIC_XTREAM_PASS=

# Set to 1 to also start the Vite dev server on http://localhost:5173
NEXONIC_DEV=0

# --- Docker (docker compose) ---
# 127.0.0.1 = only this computer can open it. 0.0.0.0 = devices on your home network (Smart TV) can too.
# NEXONIC_BIND=127.0.0.1
# Port on this computer (inside the container it is always 8000).
# NEXONIC_PUBLIC_PORT=8000
# Address Smart TV apps should use, because the container can't see it, for example 192.168.1.20.
# NEXONIC_LAN_IP=

# --- Network TV tuner (optional) ---
# 1 = media servers on your network can add this as a live TV tuner (no login: it only lists channels and the guide).
# NEXONIC_TUNER=0
# NEXONIC_TUNER_COUNT=4
